generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  name           String
  email          String?   @unique
  username       String    @unique
  passwordHash   String
  profileSlug    String    @default("user")
  active         Boolean   @default(true)
  avatar         String?
  isManager      Boolean   @default(false)
  defaultQueueId Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tickets           Ticket[]
  sentMessages      Message[]          @relation("SentMessages")
  defaultQueue      Queue?             @relation("UserDefaultQueue", fields: [defaultQueueId], references: [id])
  queues            UserQueue[]
  scheduledTickets  ScheduledTicket[]

  @@map("users")
}

model Queue {
  id              Int       @id @default(autoincrement())
  name            String
  color           String    @default("#6366f1")
  greetingMessage String?
  order           Int       @default(0)
  autoClose       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tickets           Ticket[]
  defaultUsers      User[]             @relation("UserDefaultQueue")
  userQueues        UserQueue[]
  scheduledTickets  ScheduledTicket[]

  @@map("queues")
}

model UserQueue {
  userId  Int
  queueId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue   Queue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@id([userId, queueId])
  @@map("user_queues")
}

model Contact {
  id            Int       @id @default(autoincrement())
  name          String    @default("")
  number        String
  email         String?
  profilePicUrl String?
  company       String?
  cpf           String?
  cnpj          String?
  observation   String?
  category      String?   // Consumidor | Zweb | Clipp Pro | Gdor
  role          String?   // Cargo dentro da empresa
  blacklist     Boolean   @default(false)
  isGroup       Boolean   @default(false)
  gosacId       Int?      @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tickets           Ticket[]
  tags              ContactTag[]
  scheduledTickets  ScheduledTicket[]

  @@map("contacts")
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  color    String       @default("#6366f1")
  contacts ContactTag[]

  @@map("tags")
}

model ContactTag {
  contactId Int
  tagId     Int
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model Ticket {
  id             Int          @id @default(autoincrement())
  status         TicketStatus @default(PENDING)
  unreadMessages Int          @default(0)
  lastMessage    String?
  isGroup        Boolean      @default(false)
  aiSummary      String?
  contactId      Int
  queueId        Int?
  userId         Int?
  gosacId        Int?         @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  closedAt       DateTime?

  contact        Contact  @relation(fields: [contactId], references: [id])
  queue          Queue?   @relation(fields: [queueId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])
  messages       Message[]
  scheduledFrom  ScheduledTicket[]

  @@map("tickets")
}

enum TicketStatus {
  PENDING
  OPEN
  CLOSED
}

model Message {
  id           Int       @id @default(autoincrement())
  body         String?
  fromMe       Boolean   @default(false)
  mediaType    String    @default("chat")
  mediaUrl     String?
  read         Boolean   @default(false)
  isDeleted    Boolean   @default(false)
  quotedMsgId  Int?
  ticketId     Int
  senderUserId Int?
  gosacId      String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender       User?     @relation("SentMessages", fields: [senderUserId], references: [id])
  quotedMsg    Message?  @relation("QuotedMessages", fields: [quotedMsgId], references: [id])
  replies      Message[] @relation("QuotedMessages")

  @@map("messages")
}

model ScheduledTicket {
  id          Int      @id @default(autoincrement())
  contactId   Int
  userId      Int
  queueId     Int?
  message     String
  scheduledAt DateTime
  status      String   @default("PENDING") // PENDING | SENT | CANCELLED
  ticketId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contact     Contact  @relation(fields: [contactId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  queue       Queue?   @relation(fields: [queueId], references: [id])
  ticket      Ticket?  @relation(fields: [ticketId], references: [id])

  @@map("scheduled_tickets")
}

model AIConfig {
  id                 Int      @id @default(autoincrement())
  porterName         String   @default("Sofia")           // Nome do assistente virtual
  companyName        String   @default("PH Informática")
  companyCity        String   @default("Itumbiara-GO")
  companyDescription String   @default("")                // Serviços, especialidade
  businessHours      String   @default("")                // Ex: Seg-Sex 8h-18h, Sáb 8h-12h
  companyAddress     String   @default("")
  companyPhone       String   @default("")
  greetingMessage    String   @default("")                // Primeira mensagem (deixe vazio para IA gerar)
  additionalRules    String   @default("")                // Instruções extras livres
  collectCompany     Boolean  @default(true)              // Perguntar nome da empresa?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("ai_config")
}

model QuickReply {
  id        Int      @id @default(autoincrement())
  name      String   @unique  // atalho usado após o /
  message   String            // texto completo da mensagem
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quick_replies")
}
